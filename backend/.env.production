# HackPilot — Production Environment Variables (Lambda)
# These are injected as Lambda env vars by deploy_lambda.py.
# Never commit actual secrets. AWS credentials come from the IAM execution role.

PROJECT_NAME=HackPilot
API_V1_STR=/api

# SQLite lives in Lambda /tmp (ephemeral — DynamoDB is the durable store)
DATABASE_URL=sqlite:////tmp/hackpilot.db

# CORS — updated to Amplify URL after frontend deploy
CORS_ORIGINS=["*"]

# AI Provider
AI_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
TITAN_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_MAX_TOKENS=2000
BEDROCK_TIMEOUT_SECONDS=60

# AWS — no profile; Lambda uses IAM execution role
AWS_REGION=us-east-1

# Existing infrastructure
DYNAMODB_TABLE_NAME=hackpilot-dev-submissions
S3_BUCKET_NAME=hackpilot-dev-artifacts-318273660064

# Supabase Auth
SUPABASE_URL=https://fhzqlzbdgbfnjlyzjuuy.supabase.co
SUPABASE_ANON_KEY=sb_publishable_Cu6iF5Q6rpN3XD8okI3k2A_8GN7CIFT
